APP_ENV=development
APP_NAME=Scam Detection Chatbot

DB_HOST=localhost
DB_PORT=5432
DB_NAME=scam_chatbot
DB_USER=postgres
DB_PASSWORD=your_password_here

CLAUDE_API_KEY=your_claude_api_key_here

GROQ_API_KEY=your_groq_api_key_here
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=2048

BLACKLIST_API_URL=https://api.blacklistseller.com/api/api/v1/queries/
BLACKLIST_API_KEY=your_blacklist_api_key_here
BLACKLIST_API_TIMEOUT=10

# PDPA / PII — สร้าง salt ใหม่ด้วย: python -c "import secrets; print(secrets.token_hex(32))"
PII_SALT=change_me_to_random_64_char_hex_string

# ML Mode (Week 2 multi-class winner = XGBoost)
# alternatives: v0.1.0 (LR binary), v0.2.0-xgb (XGB binary), v0.4.0-lr-multi, v0.4.0-bert-multi
ML_CONFIDENCE_THRESHOLD=0.7
MODEL_VERSION=v0.4.0-xgb-multi

# OCR Claude Vision fallback (Q&A only, daily quota)
CLAUDE_VISION_DAILY_LIMIT=50

# --- Deployment scope + pilot gate (2026-09-10) ---
# ML mode ปิดโดย default (pilot = Q&A/RAG เท่านั้น) — เปิดกลับเมื่อ train v2 ได้
ENABLE_ML_MODE=false
# รหัสเข้าใช้งาน closed pilot — ต้องตั้งเสมอเมื่อเปิดผ่าน tunnel/host จริง (ว่าง = ไม่ล็อค)
APP_ACCESS_CODE=
# Rate limit ต่อ IP เฉพาะ /api/qa/chat (endpoint ที่มีค่า Claude API)
QA_RATE_LIMIT_PER_MINUTE=6
QA_RATE_LIMIT_PER_DAY=200
# Hosted DB (Neon/Supabase): ตั้งอันนี้ทั้งเส้นแทน DB_HOST/DB_USER ข้างบน (ต้องมี ?sslmode=require)
DATABASE_URL=
