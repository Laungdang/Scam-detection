{"id": "kaggle-tu-bc76b25b", "text": "มีใครขายชีท CS251 บ้างครับบบ ส่งในกลุ่มได้เลย", "kaggle_verdict": "safe", "kaggle_category": null, "kaggle_notes": "kaggle_label=normal kaggle_category=tu_general risk_score=0.27 platform=X/Twitter", "lexicon_dims": [], "lexicon_terms": [], "rag_used": false, "our_verdict": "off_topic", "our_title": null, "our_summary": "ครับ ผมช่วยได้เฉพาะเรื่องตรวจสอบการหลอกแกงแบบโทรศัพท์ SMS หรือข้อความน่าสงสัยเท่านั้น เรื่องอื่นขอความช่วยเหลือจากที่อื่นนะครับ ถ้ามีเบอร์โทร ลิงก์ หรือข้อความที่สงสัยว่าเป็นการหลอก ส่งมาให้ผมตรวจสอบได้เลยครับ", "our_tactics": null, "ok": true, "error": null}
