{"id": "kaggle-tu-4340f576", "text": "มีใครขายชีท TU100 บ้างคับ ส่งในกลุ่มได้เลย", "kaggle_verdict": "safe", "kaggle_category": null, "kaggle_notes": "kaggle_label=normal kaggle_category=tu_general risk_score=0.22 platform=Discord", "lexicon_dims": [], "lexicon_terms": [], "rag_used": false, "our_verdict": "off_topic", "our_title": null, "our_summary": "ชาติไม่ได้เกี่ยวกับการตรวจสอบมิจฉาชีพหรือการหลอกแอบปลอมตัวครับ ผมช่วยได้เฉพาะเรื่องที่ถูกโทรมา SMS หรือแชทมาขอเงินหรือข้อมูล หรือส่งลิงก์ที่น่าสงสัยเท่านั้น ถ้าคุณมีเรื่องแบบนั้นอยากให้ตรวจสอบ ลองส่งเบอร์โทร ข้อความ หรือลิงก์ที่น่าสงสัยมาได้เลยครับ", "our_tactics": null, "ok": true, "error": null}
{"id": "kaggle-tu-0a20136f", "text": "มีใครขายชีท TU100 บ้างครับ ทัก DM", "kaggle_verdict": "safe", "kaggle_category": null, "kaggle_notes": "kaggle_label=normal kaggle_category=tu_general risk_score=0.13 platform=Discord", "lexicon_dims": [], "lexicon_terms": [], "rag_used": false, "our_verdict": "safe", "our_title": "ถามซื้อชีทสอบ TU100", "our_summary": "ข้อความนี้เป็นการขอแนะนำหรือหาผู้ขายชีท (เอกสารเฉลย) สำหรับวิชา TU100 ไม่มีการขอให้ผู้ใช้โอนเงิน ให้ข้อมูลส่วนตัว หรือกดลิงก์ต้องสงสัย ปลอดภัยจากมิจฉาชีพตามสัญญาณที่ตรวจสอบได้", "our_tactics": [], "ok": true, "error": null}
{"id": "kaggle-tu-df52645d", "text": "รหัสยืนยันถูกส่งไปแล้ว กรุณาแจ้งรหัสภายใน 5 นาที inbox ได้", "kaggle_verdict": "danger", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=scam kaggle_category=otp risk_score=0.96 platform=LINE", "lexicon_dims": ["urgency", "credential_request"], "lexicon_terms": ["[deadline_hours]", "รหัส"], "rag_used": true, "our_verdict": "danger", "our_title": "ขอรหัสยืนยันเร่งด่วน อาจเป็นการหลอก", "our_summary": "ข้อความนี้ขอให้คุณส่งรหัสยืนยันภายใน 5 นาที ซึ่งเป็นกลวิธีทั่วไปของมิจฉาชีพ ผู้ส่งข้อความกดดันให้รีบตัดสินใจและขอข้อมูลอ่อนไหว (รหัส) ที่เมื่อให้ไปแล้วจะนำไปใช้ในการเข้าถึงบัญชีของคุณได้ ควรรีบหยุดการสนทนากับผู้ส่งและยืนยันความจริงจากแหล่งอย่างเป็นทางการแทน", "our_tactics": ["สร้างเรื่องเร่งด่วน (deadline 5 นาที) เพื่อให้คุณไม่มีเวลาคิด", "บอกว่ารหัสถูกส่งไปแล้วเพื่อสร้างความเชื่อว่า 'ของจริง'", "ขอรหัสยืนยันซึ่งเป็นข้อมูลที่เพียงพอต่อการเข้าถึงบัญชี"], "ok": true, "error": null}
{"id": "kaggle-tu-e4a6a0d3", "text": "ระบบ TU แจ้งเตือน ให้ update password ผ่าน bit.ly/example_fake ด่วนนน", "kaggle_verdict": "danger", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=scam kaggle_category=phishing risk_score=0.82 platform=Facebook Group", "lexicon_dims": ["urgency", "link_action"], "lexicon_terms": ["ด่วน", "[url_shortener]"], "rag_used": true, "our_verdict": "danger", "our_title": "ลิงก์ปลอมแปลงระบบ TU ขอเปลี่ยนรหัสผ่าน", "our_summary": "ข้อความนี้อ้างว่ามาจากระบบ TU (มหาวิทยาลัยธรรมศาสตร์) แต่ให้กดลิงก์ bit.ly ที่เป็นลิงก์สั้นซึ่งมิจฉาชีพหลายครั้งใช้ซ่อนเว็บปลอมเพื่อเก็บรหัสผ่าน นี่เป็นเทคนิก phishing ทั่วไป อันตรายมาก เพราะถ้ากดแล้วอาจโดนขโมยบัญชีและข้อมูลส่วนตัว", "our_tactics": ["อ้างชื่อหน่วยงานจริง (TU) เพื่อสร้างความน่าเชื่อถือ", "เร่งให้รีบด้วยคำว่า 'ด่วนนน' เพื่อให้ผู้ใช้ไม่มีเวลาคิด", "ใช้ลิงก์สั้น (bit.ly) ที่ซ่อนเว็บแท้จริง ลักษณะนี้เป็นอุบายโฟกัสเฉพาะเจาะจง", "ขอให้เปลี่ยนรหัสผ่าน ซึ่งเป็นข้อมูลสำคัญที่มิจฉาชีพต้องการ"], "ok": true, "error": null}
{"id": "kaggle-tu-6d1b794b", "text": "ระบบ TU แจ้งเตือน ให้ update password ผ่าน bit.ly/example_fake ด่วน 💬", "kaggle_verdict": "danger", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=scam kaggle_category=phishing risk_score=0.94 platform=X/Twitter", "lexicon_dims": ["urgency", "link_action"], "lexicon_terms": ["ด่วน", "[url_shortener]"], "rag_used": true, "our_verdict": "danger", "our_title": "SMS ปลอมแจ้งเตือน TU ให้เปลี่ยนรหัสผ่าน", "our_summary": "ข้อความนี้อ้างว่าจากระบบ TU (มหาวิทยาลัยธรรมศาสตร์) เร่งให้อัปเดตรหัสผ่านผ่านลิงก์ย่อ bit.ly ทันที นี่คือการหลอกแปลงตัวเป็นหน่วยงาน (phishing) ที่พยายามให้คุณกดลิงก์เพื่อเดือกข้อมูลส่วนตัวหรือรหัสผ่าน การรวมกันของการเร่งด่วน + อ้างอิง + ลิงก์ย่อนั้นเป็นสัญญาณอันตรายที่สูง", "our_tactics": ["อ้างชื่อหน่วยงานที่รู้จัก (TU) เพื่อสร้างความเชื่อถือ", "ใช้คำว่า 'ด่วน' เพื่อกดดันให้ผู้ใช้รีบตัดสินใจโดยไม่คิด", "ซ่อนลิงก์ด้วย URL shortener (bit.ly) เพื่อให้ผู้ใช้ไม่เห็นที่อยู่เว็บจริง", "ใช้เหตุที่ดูเหมือนสมควร (อัปเดตระบบ) เพื่อหลีกเลี่ยงความสงสัย"], "ok": true, "error": null}
{"id": "kaggle-tu-520ab9f1", "text": "ระบบ TU แจ้งเตือน ให้ update password ผ่าน example.invalid/verify ด่วน ทัก DM", "kaggle_verdict": "danger", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=scam kaggle_category=phishing risk_score=0.89 platform=Discord", "lexicon_dims": ["urgency"], "lexicon_terms": ["ด่วน"], "rag_used": false, "our_verdict": "danger", "our_title": "ลิงก์ปลอมอัปเดตรหัสผ่าน TU", "our_summary": "ข้อความนี้อ้างว่าเป็นการแจ้งเตือนจากระบบ TU แต่มีสัญญาณหลอกที่ชัดเจน คือให้คลิกลิงก์ที่ไม่ใช่เว็บไซต์จริง (example.invalid) เพื่อให้คุณป้อนรหัสผ่าน นี่เป็นวิธีหลอกเก่าแต่ยังได้ผลดีที่สุด เพราะเมื่อคุณกดลิงก์และป้อนข้อมูล ข้อมูลทั้งหมดจะไปหลุดให้คนร้าย", "our_tactics": ["อ้างชื่อบริษัท TU ที่คนเชื่อถือ", "สร้างเหตุผลว่าจำเป็นต้องอัปเดตรหัสผ่าน", "เร่งให้รีบด้วยคำว่า 'ด่วน'", "ให้ลิงก์ปลอมที่ดูคล้ายเว็บไซต์จริง (example.invalid แทนเว็บ TU จริง)", "ให้ทักผ่าน DM เพื่อให้ดูเป็นการติดต่อส่วนตัวและเป็นความลับ"], "ok": true, "error": null}
{"id": "kaggle-tu-71d9f0d1", "text": "ระบบ TU แจ้งเตือน ให้ update password ผ่าน forms.example.invalid/fake ด่วน line: @fakeid", "kaggle_verdict": "danger", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=scam kaggle_category=phishing risk_score=0.93 platform=Facebook Group", "lexicon_dims": ["urgency", "channel_shift"], "lexicon_terms": ["ด่วน", "[line_id_handle]"], "rag_used": true, "our_verdict": "danger", "our_title": "SMS ปลอมแปลงระบบ TU ขอให้เปลี่ยนรหัสผ่าน", "our_summary": "ข้อความนี้อ้างมาจากระบบ TU (มหาวิทยาลัยธรรมศาสตร์) แจ้งให้เปลี่ยนรหัสผ่านด่วน แต่ลิงก์ที่ให้คลิกเป็นโดเมนปลอมแปลง (forms.example.invalid/fake) และขอให้ติดต่อผ่าน Line ที่ไม่เป็นที่สำเคัญ โครงสร้างนี้เป็นแบบฟิชชิง (ปลอมแปลงหน่วยงาน) เพื่อให้คุณกดลิงก์ปลอมและป้อนชื่อผู้ใช้กับรหัสผ่าน", "our_tactics": ["ปลอมแปลงตัวเป็นหน่วยงาน (มหาวิทยาลัยธรรมศาสตร์) เพื่อให้เชื่อถือ", "สร้างความเร่งด่วนด้วยคำว่า 'ด่วน' เพื่อให้รีบตัดสินใจโดยไม่คิด", "ให้ลิงก์ปลอมแปลงที่ดูเหมือนการแจ้งเตือนจริง เพื่อให้ป้อนรหัสผ่าน", "ให้ติดต่อผ่าน Line ID ที่ไม่เป็นอย่างรับรองเพื่อขาดความโปร่งใส"], "ok": true, "error": null}
{"id": "kaggle-tu-f1bc84c5", "text": "ระบบ TU แจ้งเตือน ให้ update password ผ่าน forms.example.invalid/fake ด่วนนน", "kaggle_verdict": "danger", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=scam kaggle_category=phishing risk_score=0.94 platform=Facebook Group", "lexicon_dims": ["urgency"], "lexicon_terms": ["ด่วน"], "rag_used": false, "our_verdict": "danger", "our_title": "ลิงก์ปลอมแปลงตัวเป็น TU ขอเปลี่ยนรหัสผ่าน", "our_summary": "ข้อความนี้อ้างมาจากระบบ TU (บริษัทสินเชื่อ) เร่งให้อัปเดตรหัสผ่านแต่นำส่งไปที่ลิงก์ปลอม forms.example.invalid/fake นี่คือการหลอกแบบฟิชชิง ที่พยายามให้คุณกดลิงก์เท็จและเข้าสู่ระบบด้วยข้อมูลจริง เมื่อกดลิงก์ไปแล้ว มิจฉาชีพจะได้รหัสผ่านและข้อมูลบัญชีของคุณ", "our_tactics": ["อ้างชื่อบริษัทจริง (TU) เพื่อสร้างความเชื่อถือ", "สร้างความเร่งด่วนด้วยคำว่า 'ด่วนนน' เพื่อให้คุณยังไม่ทันคิดซ้ำ", "ซ่อนลิงก์ปลอมในข้อความ forms.example.invalid/fake เว้นว่างจริง แต่ปกติผู้ใช้คิดว่าเป็นลิงก์จริง", "ขอรหัสผ่านแบบตรงๆ ผ่านการสมมติว่าเป็นระบบ"], "ok": true, "error": null}
{"id": "kaggle-tu-5c70fada", "text": "ระบบ TU แจ้งเตือน ให้ update password ผ่าน tu-form.example.invalid ด่วน", "kaggle_verdict": "danger", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=scam kaggle_category=phishing risk_score=0.82 platform=LINE", "lexicon_dims": ["urgency"], "lexicon_terms": ["ด่วน"], "rag_used": false, "our_verdict": "danger", "our_title": "ลิงก์ปลอมหลอกอัปเดตรหัสผ่าน TU", "our_summary": "ข้อความนี้ปลอมตัวเป็นระบบ TU (บริษัทเครดิตบูโร) เพื่อลั่วลิงก์เว็บปลอม ที่ใช้ให้ผู้ใช้กรอกรหัสผ่านหรือข้อมูลส่วนตัว ลิงก์ 'tu-form.example.invalid' ดูเป็นลิงก์ปลอมชัดเจน เพราะ TU จริงไม่ใช้ลิงก์แบบนี้ หากกดแล้วอาจติดมัลแวร์หรือให้ข้อมูลส่วนตัวหายไปได้", "our_tactics": ["อ้างชื่อแบรนด์ TU ที่เป็นที่รู้จักเพื่อสร้างความเชื่อ", "ใช้เฟรมเหตุจำเป็น (ต้องอัปเดตรหัส) เพื่อสร้างความรีบเร่ง", "ให้ลิงก์เว็บปลอมที่เลียนแบบ TU เพื่อเก็บข้อมูลการเข้าสู่ระบบ", "ใช้คำว่า 'ด่วน' เพื่อกดดันให้ผู้ใช้ไม่คิดมากก่อนกดลิงก์"], "ok": true, "error": null}
{"id": "kaggle-tu-c58f39d4", "text": "ระบบ TU แจ้งเตือน ให้ update password ผ่าน tu-form.example.invalid ด่วนนน", "kaggle_verdict": "danger", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=scam kaggle_category=phishing risk_score=0.81 platform=SMS", "lexicon_dims": ["urgency"], "lexicon_terms": ["ด่วน"], "rag_used": false, "our_verdict": "danger", "our_title": "ลิงก์ปลอมอัปเดตรหัสผ่าน TU", "our_summary": "ข้อความนี้อ้างมาจากระบบ TU (บุคคลประเมินสินเชื่อ) เรียกให้อัปเดตรหัสผ่านผ่านลิงก์ที่ดูเหมือนปลอม (tu-form.example.invalid) นี่เป็นวิธีการหลอกอันตรายที่เรียกว่า Phishing ซึ่งมีจุดหมายขโมยรหัสผ่านและข้อมูลส่วนตัวของคุณ ลิงก์นั้นไม่ใช่ของ TU จริง ส่วนการใช้คำว่า 'ด่วน' คือการกดดันให้คุณรีบกดลิงก์โดยไม่คิดมาก", "our_tactics": ["อ้างชื่อบริษัทที่เชื่อถือได้ (TU) เพื่อให้ดูมีความสำคัญและเป็นการเรียกร้องจากหน่วยงานจริง", "ใช้ลิงก์ที่คล้ายกับโดเมนจริง แต่เปลี่ยนเป็นชื่อปลอม (tu-form.example.invalid) เพื่อให้ผู้ใช้หลงคิดว่าปลอดภัย", "เรียกร้องให้อัปเดตรหัสผ่านเพื่อให้ผู้ใช้กดลิงก์โดยปฏิกิริยาสำรับ", "เพิ่มคำว่า 'ด่วน' เพื่อสร้างแรงกดดันและลดเวลาคิดของผู้ใช้"], "ok": true, "error": null}
{"id": "kaggle-tu-477cd878", "text": "รับซื้อเครื่องคิดเลขมือสอง ขอราคาไม่แรง inbox ได้", "kaggle_verdict": "safe", "kaggle_category": null, "kaggle_notes": "kaggle_label=normal kaggle_category=tu_marketplace risk_score=0.24 platform=Web Form", "lexicon_dims": [], "lexicon_terms": [], "rag_used": false, "our_verdict": "safe", "our_title": "ข้อความซื้อเครื่องคิดเลขมือสอง", "our_summary": "นี่คือข้อความโพสต์ขายของมือสองธรรมดา ไม่มีการขอเงิน ข้อมูลส่วนตัว หรือให้กดลิงก์ ผู้ขายเพียงแต่เสนอให้ติดต่อ inbox เพื่อเจรจาราคา ไม่มีสัญญาณการหลอกเลย", "our_tactics": [], "ok": true, "error": null}
{"id": "kaggle-tu-a641491f", "text": "ระบบ TU แจ้งเตือน ให้ update password ผ่าน [URL] ด่วน inbox ได้", "kaggle_verdict": "danger", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=scam kaggle_category=phishing risk_score=0.94 platform=Facebook Group", "lexicon_dims": ["urgency"], "lexicon_terms": ["ด่วน"], "rag_used": false, "our_verdict": "danger", "our_title": "SMS อ้างระบบ TU ให้อัปเดตรหัสผ่าน", "our_summary": "ข้อความนี้จำลองเป็นแจ้งเตือนจากระบบ TU (บริษัทตรวจสอบเครดิต) เพื่อให้คุณกดลิงก์อัปเดตรหัสผ่าน นี่คือเทคนิค phishing ทั่วไปที่มิจฉาชีพใช้เพื่อขโมยข้อมูลล็อกอินของคุณ เมื่อกดลิงก์จะไปยังเว็บปลอมที่ออกแบบเหมือนจริง พอคุณป้อนรหัสผ่าน มิจฉาชีพก็ขโมยได้ทันที", "our_tactics": ["ปลอมเป็นหน่วยงานหรือบริษัทจริงที่คุณเชื่อถือ (TU)", "ใช้คำว่า 'ด่วน' เพื่อกดดันให้รีบตัดสินใจโดยไม่คิดทันหรือตรวจสอบ", "เตรียมลิงก์ URL ปลอมไว้ เพื่อให้คุณป้อนข้อมูลส่วนตัวและรหัสผ่าน"], "ok": true, "error": null}
{"id": "kaggle-tu-a3e0e08f", "text": "ระบบแจ้งให้ยืนยัันข้อมูลบางอย่างภายในวันนี้", "kaggle_verdict": "caution", "kaggle_category": "phishing_link", "kaggle_notes": "kaggle_label=suspicious kaggle_category=phishing_risk risk_score=0.65 platform=IG DM", "lexicon_dims": ["urgency"], "lexicon_terms": ["ภายในวันนี้"], "rag_used": false, "our_verdict": "caution", "our_title": "ข้อความร่างรีบขอยืนยันข้อมูล", "our_summary": "ข้อความนี้ขอให้ยืนยันข้อมูลอย่างเร่งรีบภายในวันนี้ แต่ไม่ระบุว่าเป็นอะไร ใครส่ง หรือต้องยืนยันที่ไหน นี่เป็นรูปแบบที่มิจฉาชีพนิยมใช้เพื่อให้ผู้ใช้กระทำตัดสินใจโดยไม่คิดพอ คุณต้องตรวจสอบเพิ่มเติมก่อนดำเนินการ", "our_tactics": ["สร้างความรีบเร่งด้วยกำหนดเวลา ('ภายในวันนี้') เพื่อให้ผู้ใช้ไม่มีเวลาคิดอย่างชิดเชิด", "ใช้คำว่า 'ยืนยัน' ซึ่งฟังดูเป็นทางการและสำคัญ แต่ไม่บอกรายละเอียดว่าที่ไหนหรือทำไม", "ไม่ระบุชื่อธนาคาร บริษัท หรือหน่วยงาน ทำให้ผู้ใช้ถือว่าเชื่อถือได้"], "ok": true, "error": null}
{"id": "kaggle-tu-37544bc8", "text": "รับทุนการศึกษาเร่งด่วน กรอกข้อมูลและเลขบชที่ bit.ly/example_fake", "kaggle_verdict": "danger", "kaggle_category": "prize_scam", "kaggle_notes": "kaggle_label=scam kaggle_category=fake_scholarship risk_score=0.87 platform=Facebook Group", "lexicon_dims": ["credential_request", "link_action"], "lexicon_terms": ["กรอกข้อมูล", "[url_shortener]"], "rag_used": true, "our_verdict": "danger", "our_title": "ทุนปลอม ขอข้อมูลและเลขบัญชี", "our_summary": "ข้อความนี้หลอกให้กรอกข้อมูลส่วนตัวและเลขบัญชีผ่านลิงก์ย่อ ซึ่งเป็นรูปแบบสแมชฟิชชิ่งเดียวกับที่มิจฉาชีพใช้หลอกเรื่องทุนการศึกษา คลายธรรมชาติ แต่หลอกเสียเงินเข้าบัญชีของคนร้าย เขียนเร่งด่วนเพื่อให้คุณไม่ทันคิดดี", "our_tactics": ["สร้างความหวัง: อ้างทุนการศึกษาเพื่อให้ผู้ใช้อยากได้เงิน", "ให้ลิงก์ย่อ: ซ่อนที่อยู่เว็บจริงไว้ เมื่อกดเข้าเป็นเว็บปลอมที่เก็บข้อมูล", "ขอข้อมูลส่วนตัวและเลขบัญชี: รวบรวมเพื่อโจมตีบัญชีหรือนำไปฉ้อโกง", "เร่งด่วน: คำว่า 'เร่งด่วน' บังคับให้ตัดสินใจโดยไม่คิดมากเกินไป"], "ok": true, "error": null}
{"id": "kaggle-tu-a06e97ef", "text": "รับทุนการศึกษาเร่งด่วน กรอกข้อมูลและเลขบัญชีที่ example.invalid/verify", "kaggle_verdict": "danger", "kaggle_category": "prize_scam", "kaggle_notes": "kaggle_label=scam kaggle_category=fake_scholarship risk_score=0.97 platform=LINE", "lexicon_dims": ["credential_request"], "lexicon_terms": ["กรอกข้อมูล"], "rag_used": true, "our_verdict": "danger", "our_title": "ข้อความหลอกทุนการศึกษาเทียม", "our_summary": "นี่คือข้อความหลอกแบบ Smishing ที่ลอกแบบการให้สินเชื่อ ผู้หลอกอ้างว่าคุณได้รับทุนการศึกษาแล้ว แล้วบังคับให้กรอกข้อมูลส่วนตัวและเลขบัญชีที่เว็บไซต์ปลอม การกรอกข้อมูลลงไปจะทำให้เลขบัญชีและข้อมูลส่วนตัวของคุณถูกโจรกรรม", "our_tactics": ["อ้างว่าคุณได้รับทุนหรือสินเชื่อเพื่อให้คุณตื่นเต้น", "เร่งให้กรอกข้อมูลด้วยการบอกว่า 'เร่งด่วน' เพื่อไม่ให้คุณนึกคิดมากเกินไป", "ให้ลิงก์ไปยังเว็บไซต์ปลอมที่เลียนแบบเว็บจริง เพื่อขโมยข้อมูลส่วนตัวและเลขบัญชี"], "ok": true, "error": null}
{"id": "kaggle-tu-d83df5cc", "text": "รับทุนการศึกษาเร่งด่วน กรอกข้อมูลและเลขบัญชีที่ bit.ly/example_fake ทัก DM", "kaggle_verdict": "danger", "kaggle_category": "prize_scam", "kaggle_notes": "kaggle_label=scam kaggle_category=fake_scholarship risk_score=0.92 platform=LINE", "lexicon_dims": ["credential_request", "link_action"], "lexicon_terms": ["กรอกข้อมูล", "[url_shortener]"], "rag_used": true, "our_verdict": "danger", "our_title": "ทุนปลอมขอข้อมูลและบัญชีธนาคาร", "our_summary": "ข้อความนี้เป็นการหลอกลวงเรื่องทุนการศึกษา มิจฉาชีพขอให้กรอกข้อมูลส่วนตัวและเลขบัญชี แล้วให้กดลิงก์ที่ย่อมา ซึ่งเป็นวิธีการหลอกแบบคลาสสิก ลิงก์ y่อมาอาจนำไปยังเว็บปลอมเพื่อโจรกรรมข้อมูลและเงินในบัญชีของคุณ", "our_tactics": ["แกล้งทำเป็นโครงการทุนการศึกษาของจริง", "ขอข้อมูลส่วนตัวและเลขบัญชีธนาคาร", "ให้กดลิงก์ย่อมา (bit.ly) เพื่อปิดบังไซต์ปลอมที่แท้จริง", "ชักชวนให้ติดต่อผ่าน DM ลิงก์ สร้างบรรยากาศเป็นการติดต่อส่วนตัว"], "ok": true, "error": null}
{"id": "kaggle-tu-b2e8c178", "text": "รับทุนการศึกษาเร่งด่วน กรอกข้อมูลและเลขบัญชีที่ example.invalid/verify pls", "kaggle_verdict": "danger", "kaggle_category": "prize_scam", "kaggle_notes": "kaggle_label=scam kaggle_category=fake_scholarship risk_score=0.81 platform=SMS", "lexicon_dims": ["credential_request"], "lexicon_terms": ["กรอกข้อมูล"], "rag_used": true, "our_verdict": "danger", "our_title": "SMS เพื่อหลอกข้อมูลบัญชีและตัวตน", "our_summary": "ข้อความนี้อ้างว่าคุณได้รับทุนการศึกษาเร่งด่วน แล้วให้คุณกรอกข้อมูลและเลขบัญชีผ่านลิงก์ที่สงสัย นี่เป็นวิธีหลอกแบบ phishing ที่พบบ่อยในฐานข้อมูลเคส smishing — ผู้ร้ายจะนำข้อมูลไปใช้สร้างหนี้สินหรือแสดงตัวแทนคุณ", "our_tactics": ["อ้างว่ามีทุนการศึกษาเข้ามา เพื่อสร้างความตั้งใจให้รีบปฏิบัติ", "ใช้คำว่า 'เร่งด่วน' เพื่อกดดันให้ไม่คิดให้หนักแน่น", "ให้กรอกข้อมูลส่วนตัวและเลขบัญชี ซึ่งนี่คือเป้าหมายแท้จริง", "ทำให้ดูเป็นข้อความตามธรรมชาติเหมือนข้อความบอกข่าวดี"], "ok": true, "error": null}
{"id": "kaggle-tu-6db7dccb", "text": "รับทุนการศึกษาเร่งด่วน กรอกข้อมูลและเลขบัญชีที่ forms.example.invalid/fake line: @fakeid", "kaggle_verdict": "danger", "kaggle_category": "prize_scam", "kaggle_notes": "kaggle_label=scam kaggle_category=fake_scholarship risk_score=0.89 platform=TU Marketplace", "lexicon_dims": ["credential_request", "channel_shift"], "lexicon_terms": ["กรอกข้อมูล", "[line_id_handle]"], "rag_used": true, "our_verdict": "danger", "our_title": "SMS ลวงรับทุนศึกษา ให้กรอกข้อมูลส่วนตัว", "our_summary": "ข้อความนี้อ้างว่าคุณได้รับทุนการศึกษา แล้วขอให้กรอกข้อมูลและเลขบัญชี ผ่านลิงก์ฟร้อม (forms.example.invalid) และ LINE ID ที่ไม่เป็นทางการ ทั้งลิงก์และวิธีการทั้งหมดเป็นเคล็ดลับมิจฉาชีพเพื่อขโมยข้อมูลส่วนตัวและบัญชีเงินของคุณ", "our_tactics": ["อ้างว่ามีทุนหรือเงินกู้ที่อนุมัติแล้ว เพื่อกระตุ้นให้คุณลงมือโดยรีบร้อน", "ให้ย้ายไปติดต่อผ่าน LINE ID ที่ไม่เป็นทางการ เพื่อหลีกเลี่ยงการตรวจสอบ", "ขอให้กรอกข้อมูลส่วนตัวและเลขบัญชีในลิงก์ฟร้อม ซึ่งเป็นเวบไซต์ปลอม (fake form)", "ใช้ชื่อเว็บไซต์ที่ดูเหมือนสุนทร แต่จริงๆ เป็นเว็บปลอมที่ออกแบบมาเพื่อโจมตีเท่านั้น"], "ok": true, "error": null}
{"id": "kaggle-tu-7503aa1f", "text": "รับทุนการศึกษาเร่งด่วน กรอกข้อมูลและเลขบัญชีที่ tu-form.example.invalid ส่งในกลุ่มได้เลย", "kaggle_verdict": "danger", "kaggle_category": "prize_scam", "kaggle_notes": "kaggle_label=scam kaggle_category=fake_scholarship risk_score=0.93 platform=Web Form", "lexicon_dims": ["credential_request"], "lexicon_terms": ["กรอกข้อมูล"], "rag_used": true, "our_verdict": "danger", "our_title": "ทุนการศึกษาปลอม ขอข้อมูลส่วนตัว", "our_summary": "ข้อความนี้อ้างว่าเป็นทุนการศึกษาเร่งด่วน แต่ขอให้กรอกข้อมูลและเลขบัญชีในเว็บไซต์ที่สร้างขึ้นมา นี่เป็นวิธีการโฟมปลอม (phishing) ที่พบเกิดซ้ำๆ ในฐานข้อมูล คนร้ายจะนำข้อมูลดังกล่าวไปใช้สร้างการหลอกต่อหรือปลอมตัว", "our_tactics": ["อ้างทุนการศึกษา/ทุนช่วยเหลือที่คนหนุ่มสาวมักสนใจ", "สร้างความเร่งด่วนด้วยคำว่า 'เร่งด่วน' เพื่อบังคับให้ตัดสินใจรวดเร็ว", "ขอข้อมูลส่วนตัวและเลขบัญชี อ้างว่าต้องกรอกในแบบฟอร์มออนไลน์", "ให้ลิงก์ไปยังเว็บไซต์ปลอมที่ชื่อเหมือนจริง (tu-form.example.invalid)", "ขอให้ส่งในกลุ่มเพื่อแพร่กระจายแม่นต่อถึงเหยื่อจำนวนมากในเวลาอันสั้น"], "ok": true, "error": null}
{"id": "kaggle-tu-6695b3d0", "text": "รับหิ้วของจากญี่ปุ่น สนใจทักได้ นัดรับได้ในมอ ส่งในกลุ่มได้เลย", "kaggle_verdict": "safe", "kaggle_category": null, "kaggle_notes": "kaggle_label=normal kaggle_category=tu_general risk_score=0.19 platform=Discord", "lexicon_dims": [], "lexicon_terms": [], "rag_used": false, "our_verdict": "safe", "our_title": "โพสต์รับหิ้วของจากญี่ปุ่น", "our_summary": "ข้อความนี้เป็นโพสต์ประกาศหรือลงขายของทั่วไป ผู้โพสต์แจ้งว่ารับหิ้วของจากญี่ปุ่นมาขาย ไม่มีการขอโอนเงิน ขอข้อมูลส่วนตัว หรือให้กดลิงก์ใดๆ เลย จึงไม่มีลักษณะการหลอกแบบปกติ", "our_tactics": [], "ok": true, "error": null}
{"id": "kaggle-tu-6f3e722e", "text": "รับทุนการศึกษาเร่งด่วนนน กรอกข้อมูลและเลขบัญชีที่ forms.example.invalid/fake", "kaggle_verdict": "danger", "kaggle_category": "prize_scam", "kaggle_notes": "kaggle_label=scam kaggle_category=fake_scholarship risk_score=0.94 platform=SMS", "lexicon_dims": ["credential_request"], "lexicon_terms": ["กรอกข้อมูล"], "rag_used": true, "our_verdict": "danger", "our_title": "ขอข้อมูลและเลขบัญชีด้วยเหตุปลอม", "our_summary": "ข้อความนี้อ้างว่าคุณได้รับการอนุมัติทุนการศึกษา แล้วขอให้กรอกข้อมูลส่วนตัวและเลขบัญชีในแบบฟอร์มปลอม โปรแกรมทุนจริงจะไม่เรียกข้อมูลธนาคารผ่านลิงก์แบบฟอร์มออนไลน์ เช่นนี้ มิจฉาชีพขโมยข้อมูลเพื่อเปิดบัญชีปลอมหรือใช้ยักยอก", "our_tactics": ["อ้างว่ามีทุนการศึกษาและการอนุมัติแล้ว เพื่อให้คนตัวใจยินดี", "ทำแบบฟอร์ม URL ปลอมให้ดูเหมือนจริง เพื่อให้ผู้ใช้ไว้ใจและกรอกข้อมูล", "ขอข้อมูลส่วนตัวและเลขบัญชี ซึ่งนำไปใช้ยักยอกหรือฉ้อโรงได้ทันที"], "ok": true, "error": null}
{"id": "kaggle-tu-c8bd29fb", "text": "รับทุนการศึกษาเร่งด่วน กรอกข้อมูลและเลขบัญชีที่ [URL] line: @fakeid", "kaggle_verdict": "danger", "kaggle_category": "prize_scam", "kaggle_notes": "kaggle_label=scam kaggle_category=fake_scholarship risk_score=0.94 platform=Discord", "lexicon_dims": ["credential_request", "channel_shift"], "lexicon_terms": ["กรอกข้อมูล", "[line_id_handle]"], "rag_used": true, "our_verdict": "danger", "our_title": "ข้อความหลอกสินเชื่อขอข้อมูล", "our_summary": "ข้อความนี้อ้างว่าคุณได้รับอนุมัติทุนการศึกษาเร่งด่วน แล้วให้ไปกรอกข้อมูลและเลขบัญชีในเว็บไซต์ที่ไม่น่าเชื่อถือ นอกจากนี้ยังให้ย้ายไปติดต่อผ่าน LINE ที่มิจฉาชีพสร้างขึ้น เป็นเคสลวงขอข้อมูลส่วนตัวและเลขบัญชีเพื่อนำไปใช้หลอกแอบหรือโจรกรรม", "our_tactics": ["อ้างเงินทุนหรือสินเชื่อขึ้นมาไม่มีจริง", "สร้างความรับสายได้อยากรีบ โดยใช้คำว่า 'เร่งด่วน'", "ให้ไปกดลิงก์ไปยังเว็บปลอม เพื่อให้ผู้ใช้กรอกข้อมูลส่วนตัว", "ให้ยืมเลขบัญชีของคุณ เมื่อได้แล้วนำไปเปิดสินเชื่อ หรือโอนเงินหลวงออกมา", "ให้ย้ายไปคุยผ่าน LINE เพื่อหลีกเลี่ยงการติดตามโดยหน่วยงานจริง"], "ok": true, "error": null}
